# Copy this file to .env.erapower-login in the project root and fill it locally.
# Quote values. This file is read by the eraPower scripts, not Windows Credential Manager.
ERAPOWER_USERNAME="replace-with-your-username"
ERAPOWER_PASSWORD="replace-with-your-password"
# Leave blank to use eraPower's default workstation.
ERAPOWER_WORKSTATION=""
